<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- IMPORTANTE: conserva la linea android:theme tal como esta en TU manifest original
         (debe coincidir con el nombre de tu tema en res/values/themes.xml) -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Estacionamiento">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MenuActivity" android:exported="false" />
        <activity android:name=".MonitorActivity" android:exported="false" />
        <activity android:name=".SensorActivity" android:exported="false" />
        <activity android:name=".HistorialActivity" android:exported="false" />
    </application>

</manifest>
